---
import '../styles/global.css';
import { operators, layerOrder, byLayer } from '../data/index';
import { layerInfo } from '../data/types';

interface Props { title: string; description?: string; current?: string; section?: string }
const { title, description = 'TouchDesigner operators for movement analysis, built on EyesWeb.', current, section } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · EyesWeb TD</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="topbar">
      <button class="menu-btn" aria-label="Menu" onclick="document.body.classList.toggle('nav-open')">☰</button>
      <a class="brand" href={base}>
        <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" style="color:var(--text)">
          <path d="M4 9 C 12 19, 20 25, 29 27" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M3 19 C 10 11, 18 6, 28 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M24 2 C 20 10, 20 20, 26 30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="15" cy="15.5" r="2.8" fill="#a8bf86"/>
        </svg>
        EyesWeb TD <small>operators</small>
      </a>
      <nav class="topnav">
        <a href={base} aria-current={section === 'catalog' ? 'page' : undefined}>Catalog</a>
        <a href={`${base}start`} aria-current={section === 'start' ? 'page' : undefined}>Get started</a>
        <a href={`${base}concepts`} aria-current={section === 'concepts' ? 'page' : undefined}>Concepts</a>
      </nav>
    </header>
    <div class="shell">
      <aside class="sidebar">
        <input id="side-search" type="search" placeholder={`Search ${operators.length} operators…`} aria-label="Search operators" />
        <div class="side-group">
          <div class="side-title">Guide</div>
          <a href={`${base}start`} aria-current={section === 'start' ? 'page' : undefined}>Get started</a>
          <a href={`${base}concepts`} aria-current={section === 'concepts' ? 'page' : undefined}>Concepts</a>
        </div>
        {layerOrder.map((layer) => (
          <div class={`side-group ${layer}`}>
            <div class="side-title"><span class="sw"></span>{layer} · {layerInfo[layer].name}</div>
            {byLayer(layer).map((op) => (
              <a href={`${base}operators/${op.slug}`} data-name={op.title.toLowerCase()} aria-current={current === op.slug ? 'page' : undefined}>
                {op.title}<span class={`dot ${op.state ?? ''}`} title={op.state}></span>
              </a>
            ))}
          </div>
        ))}
      </aside>
      <main class="content">
        <slot />
      </main>
    </div>
    <script is:inline>
      (function () {
        var input = document.getElementById('side-search');
        if (!input) return;
        input.addEventListener('input', function () {
          var q = input.value.trim().toLowerCase();
          document.querySelectorAll('.sidebar a[data-name]').forEach(function (a) {
            a.style.display = !q || a.dataset.name.indexOf(q) >= 0 ? '' : 'none';
          });
        });
        var cur = document.querySelector('.sidebar a[aria-current]');
        var side = document.querySelector('.sidebar');
        if (cur && side) side.scrollTop = cur.offsetTop - side.clientHeight / 2;
      })();
    </script>
  </body>
</html>
